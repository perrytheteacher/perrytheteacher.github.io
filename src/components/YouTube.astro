---
// Vložení videa z YouTube. Použití v kapitole:
// <YouTube id="KÓD_VIDEA" title="Název videa" />
// KÓD_VIDEA je část adresy za "v=", např. u https://www.youtube.com/watch?v=abc123 je to abc123.
interface Props {
	id: string;
	title?: string;
}
const { id, title = 'Video' } = Astro.props;
---

<div class="video">
	<iframe
		src={`https://www.youtube-nocookie.com/embed/${id}`}
		title={title}
		loading="lazy"
		allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
		allowfullscreen></iframe>
</div>

<style>
	.video {
		position: relative;
		aspect-ratio: 16 / 9;
		width: 100%;
	}
	.video iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		border-radius: 0.5rem;
	}
</style>
