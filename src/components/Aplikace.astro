---
// Vložení vlastní HTML aplikace. Aplikaci nahrajte do složky public/aplikace/<nazev>/index.html
// a v kapitole ji vložte takto:
// <Aplikace src="/aplikace/nazev/" title="Popis aplikace" vyska={600} />
// Volitelně stahnout="nazev-souboru.html" přidá odkaz ke stažení aplikace pro offline práci
// (aplikace musí být jeden soběstačný HTML soubor).
interface Props {
	src: string;
	title?: string;
	vyska?: number;
	stahnout?: string;
}
const { src, title = 'Interaktivní aplikace', vyska = 560, stahnout } = Astro.props;
const adresa = import.meta.env.BASE_URL.replace(/\/$/, '') + src;
const online = new URL(adresa, Astro.site).href;
---

<figure class="aplikace">
	<iframe src={adresa} title={title} loading="lazy" style={`height:${vyska}px`}></iframe>
	<figcaption>
		<span class="tisk-skryt">{title} · <a href={adresa} target="_blank" rel="noopener">otevřít na celou obrazovku</a>{stahnout && <> · <a href={adresa.replace(/\/?$/, '/') + 'index.html'} download={stahnout}>stáhnout pro offline práci</a></>}</span>
		<span class="tisk-jen">Interaktivní aplikace „{title}“ – vyzkoušej online: {online}</span>
	</figcaption>
</figure>

<style>
	.aplikace {
		margin: 1rem 0;
	}
	.aplikace iframe {
		width: 100%;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		background: white;
	}
	.aplikace figcaption {
		font-size: 0.85rem;
		color: var(--sl-color-gray-3);
		margin-top: 0.25rem;
	}
	.tisk-jen {
		display: none;
	}
	@media print {
		.aplikace iframe,
		.tisk-skryt {
			display: none;
		}
		.tisk-jen {
			display: block;
			padding: 0.5rem 0.75rem;
			border: 1px dashed #888;
			border-radius: 0.4rem;
			color: #333;
		}
	}
</style>
