---
// Procvičovací otázka s výběrem odpovědi a okamžitou zpětnou vazbou.
// Použití:
// <Otazka
//   zadani="Kolik protonů má atom uhlíku?"
//   moznosti={["4", "6", "12"]}
//   spravne={1}
//   vysvetleni="Protonové číslo uhlíku je 6."
// />
// "spravne" je pořadí správné možnosti, počítáno od nuly (0 = první možnost).
interface Props {
	zadani: string;
	moznosti: string[];
	spravne: number;
	vysvetleni?: string;
}
const { zadani, moznosti, spravne, vysvetleni = '' } = Astro.props;
---

<div class="otazka" data-spravne={spravne}>
	<p class="zadani" set:html={zadani} />
	<div class="moznosti">
		{moznosti.map((m, i) => <button type="button" data-i={i} set:html={m} />)}
	</div>
	<p class="vysledek" hidden></p>
	{vysvetleni && <p class="vysvetleni" hidden set:html={vysvetleni} />}
</div>

<script>
	document.querySelectorAll<HTMLElement>('.otazka').forEach((blok) => {
		const spravne = Number(blok.dataset.spravne);
		const vysledek = blok.querySelector<HTMLElement>('.vysledek')!;
		const vysvetleni = blok.querySelector<HTMLElement>('.vysvetleni');
		blok.querySelectorAll<HTMLButtonElement>('button').forEach((tl) => {
			tl.addEventListener('click', () => {
				blok.querySelectorAll('button').forEach((b) => b.classList.remove('spatne'));
				const ok = Number(tl.dataset.i) === spravne;
				tl.classList.add(ok ? 'dobre' : 'spatne');
				vysledek.hidden = false;
				vysledek.textContent = ok ? 'Správně!' : 'Zkuste to znovu.';
				if (ok && vysvetleni) vysvetleni.hidden = false;
			});
		});
	});
</script>

<style>
	.otazka {
		border: 1px solid var(--sl-color-hairline);
		border-radius: 0.5rem;
		padding: 1rem;
		margin: 1rem 0;
	}
	.zadani {
		font-weight: 600;
		margin: 0 0 0.75rem;
	}
	.moznosti {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
	}
	.moznosti button {
		font: inherit;
		padding: 0.4rem 0.9rem;
		border-radius: 0.4rem;
		border: 1px solid var(--sl-color-gray-4);
		background: var(--sl-color-bg);
		color: var(--sl-color-text);
		cursor: pointer;
	}
	.moznosti button.dobre {
		border-color: var(--sl-color-green);
		background: var(--sl-color-green-low);
	}
	.moznosti button.spatne {
		border-color: var(--sl-color-red);
		background: var(--sl-color-red-low);
	}
	.vysledek {
		font-weight: 600;
		margin: 0.75rem 0 0;
	}
	.vysvetleni {
		margin: 0.25rem 0 0;
	}
</style>
